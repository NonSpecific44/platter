{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Platter",
  "mainBinaryName": "platter",
  "version": "0.3.10",
  "identifier": "io.github.tonearm.Tonearm",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Platter",
        "width": 1280,
        "height": 820,
        "minWidth": 340,
        "minHeight": 96,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPCACHE/covers/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage"
    ],
    "category": "Music",
    "shortDescription": "A Plex music player for the Linux desktop",
    "longDescription": "Platter streams music from your Plex Media Server with gapless playback, synced lyrics, MPRIS media keys and a fast keyboard-driven interface.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlFMUVBMkQ5QTRDRkNFNEYKUldSUHpzK2syYUllbnUzZ091Mnl3aGYrZnAxelQ2VkZSOFRFajdDNGNDMkdZZGdQWDRYSWljUFAK",
      "endpoints": []
    }
  }
}
