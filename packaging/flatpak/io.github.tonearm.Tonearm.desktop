[Desktop Entry]
Type=Application
Name=Platter
GenericName=Music Player
Comment=Play music from your Plex Media Server
Exec=platter %U
Icon=io.github.tonearm.Tonearm
Terminal=false
Categories=AudioVideo;Audio;Player;
Keywords=plex;music;player;audio;
StartupWMClass=tonearm
Actions=PlayPause;Next;Previous;

[Desktop Action PlayPause]
Name=Play/Pause
Exec=platter --toggle

[Desktop Action Next]
Name=Next Track
Exec=platter --next

[Desktop Action Previous]
Name=Previous Track
Exec=platter --previous
