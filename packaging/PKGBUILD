# Build from the project folder:  cd packaging && makepkg -si
pkgname=tonearm
pkgver=0.1.2
pkgrel=1
pkgdesc="A Plex music player for the Linux desktop"
arch=('x86_64')
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'mpv' 'libayatana-appindicator' 'dbus')
makedepends=('rust' 'cargo' 'nodejs' 'npm')
options=('!lto')

build() {
  cd "$startdir/.."
  npm ci
  npx tauri build --no-bundle
}

package() {
  cd "$startdir/.."
  install -Dm755 src-tauri/target/release/tonearm "$pkgdir/usr/bin/tonearm"
  install -Dm644 packaging/tonearm.desktop "$pkgdir/usr/share/applications/tonearm.desktop"
  install -Dm644 src-tauri/icons/128x128.png "$pkgdir/usr/share/icons/hicolor/128x128/apps/tonearm.png"
  install -Dm644 src-tauri/icons/128x128@2x.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/tonearm.png"
  install -Dm644 icon.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/tonearm.svg"
  install -Dm644 packaging/ufw/tonearm "$pkgdir/etc/ufw/applications.d/tonearm"
}
