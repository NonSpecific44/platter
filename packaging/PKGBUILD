# Build from the project folder:  cd packaging && makepkg -si
pkgname=platter
# Formerly "Tonearm".
replaces=(tonearm)
conflicts=(tonearm)
pkgver=0.3.0
pkgrel=1
pkgdesc="A Plex music player for the Linux desktop"
arch=('x86_64')
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'mpv' 'libayatana-appindicator' 'dbus')
makedepends=('rust' 'cargo' 'nodejs' 'npm')
options=('!lto')

build() {
  cd "$startdir/.."
  npm ci
  npx tauri build --no-bundle
}

package() {
  cd "$startdir/.."
  install -Dm755 src-tauri/target/release/platter "$pkgdir/usr/bin/platter"
  install -Dm644 packaging/platter.desktop "$pkgdir/usr/share/applications/platter.desktop"
  install -Dm644 src-tauri/icons/128x128.png "$pkgdir/usr/share/icons/hicolor/128x128/apps/platter.png"
  install -Dm644 src-tauri/icons/128x128@2x.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/platter.png"
  install -Dm644 icon.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/platter.svg"
  install -Dm644 packaging/ufw/platter "$pkgdir/etc/ufw/applications.d/platter"
}
